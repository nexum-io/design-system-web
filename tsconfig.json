{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/design-system": ["./index.ts"],
      "@/design-system/*": ["./*"]
    }
  },
  "include": [
    "index.ts",
    "tokens.ts",
    "components",
    "primitives",
    "blocks",
    "layouts",
    "utils",
    "examples",
    "stories",
    ".storybook",
    "vitest.setup.ts"
  ]
}
